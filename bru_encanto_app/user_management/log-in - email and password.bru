meta {
  name: log-in - email and password
  type: http
  seq: 2
}

post {
  url: {{AUTH}}/token?grant_type=password
  body: json
  auth: none
}

params:query {
  grant_type: password
}

body:json {
  {
    "email": "{{email_parent02}}",
    "password": "Encanto.1234"
  }
}

assert {
  res.status: eq 200
  res.body.access_token: isDefined
}

script:post-response {
  bru.setVar("user_token", res.body.access_token);
  bru.setVar("user_role", res.body.user.user_metadata.role);
  bru.setVar("user_id", res.body.user.id);
}
